# ---- Pronto instance ----
PRONTO_BASE_URL=https://havaspronto.com

# The Mine's DAM id on this instance (3 = "The New Mine" on havaspronto.com)
MINE_DAM_ID=3

# MULTI-USER MODE (recommended): leave all credentials below empty. Users sign in
# on the app's login screen with their own HavasPronto account ("Sign in with
# HavasPronto" PKCE broker, email+password, or a pasted API token).
TOKEN_GENERATOR_URL=
# PRONTO_BROKER=off           # hide "Sign in with HavasPronto"

# SINGLE-USER FALLBACK (local dev): any of these makes cookie-less requests run
# as this one identity.
PRONTO_EMAIL=
PRONTO_PASSWORD=
PRONTO_BEARER_TOKEN=
PRONTO_COOKIE=

# ---- Server ----
PORT=8788

# ---- Persistent store (REQUIRED on Vercel: sessions + PKCE state) ----
# Provision Upstash Redis from the Vercel Marketplace; it injects these:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or: REDIS_URL=redis://localhost:6379
